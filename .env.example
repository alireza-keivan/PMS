# Copy to .env and fill in. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-generate-a-real-one
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://villa:villa@localhost:5433/villadash

# Celery / Redis
REDIS_URL=redis://localhost:6380/0

# Beds24 - premium sync tier. https://beds24.com/api/
# Long-lived refresh token; the client exchanges it for short-lived access tokens.
BEDS24_REFRESH_TOKEN=
BEDS24_API_BASE=https://beds24.com/api/v2
BEDS24_WEBHOOK_SECRET=

# WhatsApp Business Platform (Cloud API) via a BSP - Twilio or 360dialog.
# Never use unofficial WhatsApp Web automation libraries. See CLAUDE.md.
WHATSAPP_PROVIDER=twilio
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_FROM_NUMBER=
WHATSAPP_WEBHOOK_SECRET=

# Stripe - direct booking payments land in the OWNER's account, not ours.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Object storage (prod). S3-compatible; Cloudflare R2 has no egress fees.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=

# Signed guest-portal links
GUEST_LINK_MAX_AGE_DAYS=45

# Exchange rates for owner reporting display only. Stored amounts keep their
# original currency - see CLAUDE.md.
FX_RATE_PROVIDER=manual
